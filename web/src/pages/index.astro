---
import DashboardFooter from "../components/DashboardFooter.astro"
import DashboardHeader from "../components/DashboardHeader.astro"
import OverviewSection from "../components/OverviewSection.astro"
import DashboardLayout from "../layouts/DashboardLayout.astro"
---
<DashboardLayout
  title="DeltaRelay · Dashboard"
  description="Local, private observability for DeltaRelay. Track per-session bandwidth savings and relay health."
  current="overview"
  skipLabel="Skip to overview"
>
  <DashboardHeader title="Overview" subtitle="Upload savings and relay traffic across retained sessions." />
  <OverviewSection />
  <DashboardFooter />

  <Fragment slot="scripts">
    <script src="../scripts/overview-main.ts"></script>
  </Fragment>
</DashboardLayout>
