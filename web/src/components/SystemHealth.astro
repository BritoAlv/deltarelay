---
import Icon from "./Icon.astro"
import ProviderAuth from "./ProviderAuth.astro"
---
<section id="system" class="system-section" aria-labelledby="health-checks-title">
  <div class="section-heading">
    <h2 id="health-checks-title">Health checks</h2>
    <span class="section-meta" id="system-summary" role="status" aria-live="polite">Waiting for diagnostics…</span>
  </div>
  <div class="system-grid" id="system-cards">
    <article class="system-card">
      <div class="system-card-top"><span class="system-icon"><Icon name="terminal" /></span><span class="status-pill neutral">Waiting…</span></div>
      <h3>Local gateway</h3>
      <p>Not connected</p>
    </article>
    <article class="system-card">
      <div class="system-card-top"><span class="system-icon"><Icon name="link" /></span><span class="status-pill neutral">Unknown</span></div>
      <h3>Remote host connection</h3>
      <p>Not checked</p>
    </article>
    <article class="system-card">
      <div class="system-card-top"><span class="system-icon"><Icon name="system" /></span><span class="status-pill neutral">Unknown</span></div>
      <h3>Storage &amp; mailbox</h3>
      <p>No data</p>
    </article>
    <article class="system-card">
      <div class="system-card-top"><span class="system-icon"><Icon name="globe" /></span><span class="status-pill neutral">Unobserved</span></div>
      <h3>Provider forwarding</h3>
      <p>No observations</p>
      <div class="provider-tabs" aria-hidden="true">
        <span class="provider-tab" data-selected="true">opencode-go</span>
        <span class="provider-tab">openai</span>
      </div>
      <div class="provider-panels">
        <section class="provider-panel">
          <div class="provider-panel-head"><div class="provider-name"><span class="provider-dot neutral"></span><span>opencode-go</span><span class="provider-go">GO</span></div><span class="status-pill neutral">Unobserved</span></div>
          <div class="provider-usage-empty"><span class="status-pill neutral">Unavailable</span><p>Go usage is unavailable for this OpenCode profile.</p></div>
        </section>
        <section class="provider-panel" hidden>
          <div class="provider-panel-head"><div class="provider-name"><span class="provider-dot neutral"></span><span>openai</span></div><span class="status-pill neutral">Unobserved</span></div>
          <ProviderAuth />
        </section>
      </div>
    </article>
  </div>
</section>
