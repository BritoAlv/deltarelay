---
import Icon from "./Icon.astro"
---
<section id="system" class="system-section" aria-labelledby="health-checks-title">
  <div class="section-heading">
    <h2 id="health-checks-title">Health checks</h2>
    <span class="section-meta" id="system-summary" role="status" aria-live="polite">Waiting for diagnostics…</span>
  </div>
  <div class="system-grid" id="system-cards">
    <article class="system-card">
      <div class="system-card-top"><span class="system-icon"><Icon name="terminal" /></span><span class="status-pill neutral">Waiting…</span></div>
      <h3>Local gateway</h3>
      <p>Not connected</p>
    </article>
    <article class="system-card">
      <div class="system-card-top"><span class="system-icon"><Icon name="link" /></span><span class="status-pill neutral">Unknown</span></div>
      <h3>Remote host connection</h3>
      <p>Not checked</p>
    </article>
    <article class="system-card">
      <div class="system-card-top"><span class="system-icon"><Icon name="system" /></span><span class="status-pill neutral">Unknown</span></div>
      <h3>Storage &amp; mailbox</h3>
      <p>No data</p>
    </article>
    <article class="system-card">
      <div class="system-card-top"><span class="system-icon"><Icon name="globe" /></span><span class="status-pill neutral">Unobserved</span></div>
      <h3>Provider forwarding</h3>
      <p>No observations</p>
    </article>
  </div>
</section>
