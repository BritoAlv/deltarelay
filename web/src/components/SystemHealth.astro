---
import Icon from "./Icon.astro"
import ProviderAuth from "./ProviderAuth.astro"
---
<section id="system" class="system-section" aria-labelledby="health-checks-title">
  <div class="section-heading">
    <h2 id="health-checks-title">Health checks</h2>
    <span class="section-meta" id="system-summary" role="status" aria-live="polite">Loading diagnostics…</span>
  </div>
  <div class="system-grid" id="system-cards" aria-busy="true">
    <article class="system-card">
      <div class="system-card-top"><span class="system-icon"><Icon name="terminal" /></span><span class="status-pill loading">Loading…</span></div>
      <h3>Local gateway</h3>
      <p>Loading gateway diagnostics…</p>
    </article>
    <article class="system-card">
      <div class="system-card-top"><span class="system-icon"><Icon name="link" /></span><span class="status-pill loading">Loading…</span></div>
      <h3>Remote host connection</h3>
      <p>Waiting for gateway diagnostics…</p>
    </article>
    <article class="system-card">
      <div class="system-card-top"><span class="system-icon"><Icon name="storage" /></span><span class="status-pill loading">Loading…</span></div>
      <h3>Storage &amp; mailbox</h3>
      <p>Loading storage and mailbox usage…</p>
    </article>
    <article class="system-card">
      <div class="system-card-top"><span class="system-icon"><Icon name="globe" /></span><span class="status-pill loading">Loading…</span></div>
      <h3>Provider details</h3>
      <p>Loading provider observations…</p>
      <div class="provider-panels">
        <section class="provider-panel">
          <ProviderAuth />
        </section>
      </div>
    </article>
  </div>
</section>
