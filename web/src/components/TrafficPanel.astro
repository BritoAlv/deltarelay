---
import Icon from "./Icon.astro"
---
<div class="overview-grid" id="traffic-panel">
  <article class="panel traffic-panel">
    <div class="panel-heading traffic-heading">
      <div>
        <h2>Upload traffic</h2>
        <p>Original bodies, uploads, bandwidth saved, and relay cache reuse</p>
      </div>
      <div class="traffic-controls">
        <div class="traffic-range">
          <label class="sr-only" for="chart-range">Traffic time range</label>
          <select id="chart-range">
            <option value="24h">Last 24 hours</option>
            <option value="7d">Last 7 days</option>
            <option value="30d">Last 30 days</option>
            <option value="90d">Last 90 days</option>
            <option value="custom">Custom range…</option>
          </select>
          <div id="chart-custom" class="custom-range" hidden>
            <label>From <input type="date" id="chart-start" /></label>
            <label>To <input type="date" id="chart-end" /></label>
            <button type="button" class="text-button" id="chart-apply">Apply</button>
          </div>
        </div>
        <div class="chart-view-toggle" role="group" aria-label="Traffic chart view">
          <button type="button" id="chart-view-composition" class="chart-view-button" aria-pressed="true">Composition</button>
          <button type="button" id="chart-view-trends" class="chart-view-button" aria-pressed="false">Trends</button>
        </div>
      </div>
    </div>
    <div class="traffic-summary">
      <div><span class="legend-dot original"></span><span>Original</span><strong id="chart-original">—</strong></div>
      <div><span class="legend-dot delta"></span><span>Uploaded</span><strong id="chart-encoded">—</strong></div>
      <div><span class="legend-dot saved"></span><span>Bandwidth saved</span><strong id="chart-saved">—</strong><small id="chart-saved-rate">—</small></div>
      <div><span class="legend-dot reuse"></span><span>Relay cache reuse</span><strong id="chart-reused">—</strong><small id="chart-reuse-rate">—</small></div>
    </div>
    <div id="chart-notice" class="chart-notice" role="status" hidden></div>
    <div class="chart-frame">
      <div id="traffic-chart" class="traffic-chart" role="img" tabindex="0" aria-label="Upload traffic chart awaiting data"><div class="chart-placeholder">No finished requests in this window.</div></div>
      <div id="chart-tooltip" class="chart-tooltip" role="tooltip" hidden></div>
    </div>
    <div id="chart-legend" class="chart-legend" role="list" aria-label="Chart legend"></div>
    <div class="panel-bottom"><span><Icon name="info" size={14} /> Finished requests only · aggregated locally</span><span id="chart-count">0 requests in this window</span></div>
  </article>

  <article class="panel efficiency-panel"><div class="panel-heading"><div><h2>Relay cache reuse</h2><p id="reuse-scope">Selected range</p></div><span class="small-icon"><Icon name="bolt" size={18} /></span></div><div class="efficiency-ring"><svg viewBox="0 0 160 160" aria-hidden="true"><circle class="ring-track" cx="80" cy="80" r="66" /><circle id="reuse-ring" class="ring-value" cx="80" cy="80" r="66" /></svg><div><strong id="reuse-value">—</strong><span>cache reuse</span></div></div><div class="efficiency-row"><span><i class="legend-dot reuse"></i>Reused body bytes</span><strong id="reuse-bytes">—</strong></div><div class="efficiency-row"><span><i class="legend-dot delta"></i>Raw chunks uploaded</span><strong id="uploaded-bytes">—</strong></div><p class="efficiency-note">Cache reuse and compression reduce uploads; neither guarantees lower provider billing.</p></article>
</div>
