---
import Icon from "./Icon.astro"
---
<div class="overview-grid" id="traffic-panel">
  <article class="panel traffic-panel">
    <div class="panel-heading traffic-heading">
      <div>
        <h2>Upload traffic</h2>
        <p>Original bodies, uploads, bandwidth saved, and relay cache reuse</p>
      </div>
      <div class="traffic-controls">
        <div class="chart-view-toggle" role="group" aria-label="Traffic chart view">
          <button type="button" id="chart-view-composition" class="chart-view-button" aria-pressed="true">Composition</button>
          <button type="button" id="chart-view-trends" class="chart-view-button" aria-pressed="false">Trends</button>
        </div>
      </div>
    </div>
    <div class="traffic-summary">
      <div><span class="legend-dot original" aria-hidden="true"></span><span>Original</span><strong id="chart-original">—</strong></div>
      <div><span class="legend-dot delta" aria-hidden="true"></span><span>Uploaded</span><strong id="chart-encoded">—</strong></div>
      <div><span class="legend-dot saved" aria-hidden="true"></span><span>Bandwidth saved</span><strong id="chart-saved">—</strong><small id="chart-saved-rate">—</small></div>
      <div><span class="legend-dot reuse" aria-hidden="true"></span><span>Relay cache reuse</span><strong id="chart-reused">—</strong><small id="chart-reuse-rate">—</small></div>
    </div>
    <div id="chart-notice" class="chart-notice" role="status" hidden></div>
    <div class="chart-frame">
      <div id="traffic-chart" class="traffic-chart" role="img" tabindex="0" aria-label="Upload traffic chart loading" aria-busy="true" aria-describedby="chart-keyboard-hint chart-tooltip"><div class="chart-placeholder"><span class="loading-indicator"><span class="loading-spinner" aria-hidden="true"></span>Loading local traffic…</span></div></div>
      <span id="chart-keyboard-hint" class="sr-only">Focus the chart and use the left and right arrow keys, Home, and End to inspect data points.</span>
      <div id="chart-tooltip" class="chart-tooltip" role="tooltip" aria-live="polite" aria-atomic="true" hidden></div>
    </div>
    <div class="panel-bottom"><span><Icon name="info" size={14} /> Finished requests only · aggregated locally</span><span id="chart-count"><span class="loading-indicator"><span class="loading-spinner" aria-hidden="true"></span>Loading traffic…</span></span></div>
  </article>

  <article class="panel efficiency-panel">
    <div class="panel-heading"><div><h2>Relay cache reuse</h2><p id="reuse-scope">Selected range</p></div></div>
    <div class="rail-percent"><strong id="reuse-value">—</strong><span>cache reuse</span></div>
    <div class="rail-meter" aria-hidden="true"><span class="reuse" id="reuse-meter-reuse"></span><span class="raw" id="reuse-meter-raw"></span></div>
    <div class="efficiency-row"><span><i class="legend-dot reuse" aria-hidden="true"></i>Reused body bytes</span><strong id="reuse-bytes">—</strong></div>
    <div class="efficiency-row"><span><i class="legend-dot delta" aria-hidden="true"></i>Raw chunks uploaded</span><strong id="uploaded-bytes">—</strong></div>
    <div class="rail-composition">
      <span class="rail-label">Upload composition</span>
      <div class="rail-comp-bar" aria-hidden="true"><span class="saved" id="composition-saved-bar"></span><span class="sent" id="composition-sent-bar"></span></div>
      <div class="rail-legend">
        <span><i class="dot saved" aria-hidden="true"></i>Saved <strong id="composition-saved">—</strong></span>
        <span><i class="dot sent" aria-hidden="true"></i>Sent <strong id="composition-sent">—</strong></span>
      </div>
    </div>
    <p class="efficiency-note">Cache reuse and compression reduce uploads; neither guarantees lower provider billing.</p>
  </article>
</div>
