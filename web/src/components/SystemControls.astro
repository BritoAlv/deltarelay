---
import Icon from "./Icon.astro"
import SystemMap from "./SystemMap.astro"
import RemoteSetup from "./RemoteSetup.astro"
import ComponentCards from "./ComponentCards.astro"
---
<section id="controls" class="system-section" aria-labelledby="controls-title">
  <h2 id="controls-title" class="sr-only">System controls, architecture and settings</h2>
  <div class="system-tabs" role="tablist" aria-label="System sections">
    <button id="system-controls-tab" type="button" role="tab" aria-selected="true" aria-controls="system-controls-view">Controls</button>
    <button id="system-architecture-tab" type="button" role="tab" aria-selected="false" aria-controls="system-architecture-view" tabindex="-1">Architecture <span>Read only</span></button>
    <button id="system-settings-tab" type="button" role="tab" aria-selected="false" aria-controls="system-settings-view" tabindex="-1">Settings</button>
  </div>
  <div id="control-notice" class="notice" role="status" hidden></div>
  <div id="system-controls-view" role="tabpanel" aria-labelledby="system-controls-tab">
  <div class="system-overview">
    <div class="system-overview-copy"><h3 id="control-connection" class="status-pill neutral">Checking…</h3><p id="recovery-status" class="control-detail" role="status" aria-live="polite">Waiting for the independent local supervisor…</p><p class="system-overview-note">Automatic recovery runs independently of this page. Individual component states are shown below.</p></div>
    <div class="system-overview-actions">
      <button class="button" id="start-system" type="button" disabled title="Start missing components and recover the configured system connection."><Icon name="refresh" size={16} />Start / recover system</button>
      <button class="button button-danger" id="stop-system" type="button" disabled><Icon name="power" size={16} />Shut down system…</button>
    </div>
  </div>
  <RemoteSetup />
  <ComponentCards />
  </div>
  <div id="system-architecture-view" role="tabpanel" aria-labelledby="system-architecture-tab" hidden>
    <SystemMap />
    <div class="architecture-details-title"><h3>Network, recovery and shutdown</h3><span id="architecture-data-state" class="status-pill neutral" role="status">Waiting for status…</span></div>
    <section class="architecture-details" aria-label="Network, recovery and shutdown behavior">
      <article class="panel architecture-detail">
        <div class="architecture-detail-heading"><span class="resource-icon"><Icon name="globe" size={18} /></span><h3>Network monitoring</h3></div>
        <p class="control-detail">Monitors Ethernet, Wi-Fi and VPN paths without changing them.</p>
        <dl id="network-detail" class="architecture-facts">
          <div><dt>Changes observed</dt><dd id="network-changes" class="architecture-count">—</dd></div>
          <div><dt>Last change</dt><dd><time id="network-changed-at">Waiting for status…</time></dd></div>
        </dl>
      </article>
      <article class="panel architecture-detail">
        <div class="architecture-detail-heading"><span class="resource-icon"><Icon name="refresh" size={18} /></span><h3>Automatic recovery</h3></div>
        <p class="control-detail">Checks and repairs the connection in the background.</p>
        <dl id="recovery-detail" class="architecture-facts">
          <div><dt>Automatic recovery</dt><dd><span id="recovery-mode" class="status-pill neutral">Checking…</span></dd></div>
          <div><dt>Connection attempts</dt><dd id="recovery-attempts" class="architecture-count">—</dd></div>
          <div><dt>Next retry</dt><dd><time id="recovery-next-retry">Waiting for status…</time></dd></div>
          <div><dt>Last connected</dt><dd><time id="recovery-last-connected">Waiting for status…</time></dd></div>
        </dl>
      </article>
      <article class="panel architecture-detail">
        <div class="architecture-detail-heading"><span class="resource-icon"><Icon name="power" size={18} /></span><h3>Shutdown behavior</h3></div>
        <p class="control-detail">Stops managed applications, not this computer.</p>
        <dl id="shutdown-detail" class="architecture-facts">
          <div><dt>Dashboard &amp; supervisor</dt><dd>Keep running</dd></div>
          <div><dt>This computer</dt><dd>Stays on</dd></div>
          <div><dt>Remote host</dt><dd id="shutdown-remote">Checking support…</dd></div>
          <div><dt>Shutdown readiness</dt><dd><span id="shutdown-readiness" class="status-pill neutral">Checking…</span></dd></div>
        </dl>
        <p id="shutdown-blockers" class="architecture-warning" hidden></p>
      </article>
    </section>
  </div>
  <div id="system-settings-view" role="tabpanel" aria-labelledby="system-settings-tab" hidden>
    <section class="panel control-panel recovery-settings" aria-labelledby="recovery-settings-title">
      <h3 id="recovery-settings-title">Automatic recovery settings</h3>
      <p class="control-detail">Choose how the supervisor keeps the system connected. Changes are saved automatically.</p>
      <p id="settings-availability" class="control-detail" role="status" hidden></p>
      <div class="control-settings">
        <label><input id="auto-reconnect" type="checkbox" aria-describedby="auto-reconnect-description" disabled /><span><strong>Automatic recovery</strong><span id="auto-reconnect-description" class="setting-description">Check and repair the connection in the background when network conditions change.</span></span></label>
        <label id="auto-wake-setting" hidden><input id="auto-wake" type="checkbox" aria-describedby="auto-wake-description" disabled /><span><strong>Allow automatic remote-host wake</strong><span id="auto-wake-description" class="setting-description">Wake the existing remote host when recovery needs it. <span class="setting-warning">May incur compute charges.</span></span></span></label>
      </div>
      <p class="control-detail recovery-note">Network changes trigger checks, not unconditional restarts. Intentionally stopped components stay stopped.</p>
    </section>
  </div>
  <dialog id="node-inspector" class="component-dialog" aria-labelledby="node-inspector-title">
    <header class="component-dialog-heading"><div><p class="eyebrow">COMPONENT DETAILS</p><h3 id="node-inspector-title">Component details</h3></div><button id="node-inspector-close" class="button" type="button">Close <Icon name="close" size={16} /></button></header>
    <div class="component-dialog-body"><p id="node-inspector-status" class="control-detail"></p><p id="node-inspector-detail" class="control-detail"></p><dl id="node-inspector-meta"></dl><div id="node-connections" class="node-connections"></div></div>
  </dialog>
</section>
