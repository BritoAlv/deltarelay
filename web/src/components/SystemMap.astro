---
import Icon from "./Icon.astro"
import { mapBoundaries, mapRegions, mapNodes, mapWidth, mapHeight, nodeWidth, nodeHeight } from "../lib/topology-layout"
---
<article class="panel topology-panel" aria-labelledby="topology-title">
  <div class="control-heading"><div><h3 id="topology-title">System architecture</h3><p class="control-detail">How components connect across processes and hosts.</p></div></div>
  <div class="topology-legend" role="group" aria-label="Architecture legend">
    <button type="button" class="legend-toggle" data-map-channel="request" aria-pressed="true" aria-controls="map-edges" title="Hide model request arrows"><svg class="legend-arrow request" viewBox="0 0 24 12" width="24" height="12" aria-hidden="true"><path d="M1 6 H21 M16 1 L21 6 L16 11" /></svg>Model request flow<span class="legend-toggle-state">Shown</span></button>
    <button type="button" class="legend-toggle" data-map-channel="response" aria-pressed="true" aria-controls="map-edges" title="Hide model response arrows"><svg class="legend-arrow response" viewBox="0 0 24 12" width="24" height="12" aria-hidden="true"><path d="M23 6 H3 M8 1 L3 6 L8 11" /></svg>Response / stream<span class="legend-toggle-state">Shown</span></button>
    <button type="button" class="legend-toggle" data-map-channel="control" aria-pressed="true" aria-controls="map-edges" title="Hide checks, recovery and management arrows"><svg class="legend-arrow control" viewBox="0 0 24 12" width="24" height="12" aria-hidden="true"><path d="M1 6 H21 M16 1 L21 6 L16 11" /></svg>Checks / recovery / management<span class="legend-toggle-state">Shown</span></button>
  </div>
  <dl class="map-boundary-key" aria-label="Map boundaries">
    <div><dt><span class="legend-boundary process" aria-hidden="true"></span>Process boundary</dt><dd>Encloses a process and its components</dd></div>
    <div><dt><span class="legend-boundary location" aria-hidden="true"></span>Host / location / resource</dt><dd>Groups context, not a process</dd></div>
    <div><dt><span class="legend-separator" aria-hidden="true"></span>Frontend / backend</dt><dd>Interfaces on the left, services on the right</dd></div>
  </dl>
  <div class="topology-workspace">
    <div class="map-navigation" role="group" aria-label="Map navigation">
      <button id="map-zoom-out" type="button" aria-label="Zoom out">−</button>
      <button id="map-zoom-reset" type="button" aria-label="Reset zoom to 100%" title="Reset zoom to 100%">100%</button>
      <button id="map-zoom-in" type="button" aria-label="Zoom in">+</button>
      <button id="map-fit" type="button">Fit all</button>
    </div>
    <div class="topology-viewport" tabindex="0" aria-label="System connection map" aria-describedby="map-help">
      <div class="topology-canvas" style={`aspect-ratio:${mapWidth}/${mapHeight}`}>
        <svg id="topology-links" class="topology-links" viewBox={`0 0 ${mapWidth} ${mapHeight}`} role="img" aria-label="Process boundaries, owned components, and observed connections. Dashed boundaries are not processes.">
          <defs><marker id="map-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="context-stroke" /></marker></defs>
          {mapRegions.map((region) => <g>
            <desc id={`map-boundary-${region.id}-description`}>{region.label}. This is a host/location boundary, not a process.</desc>
            <rect class="map-region" data-map-group={region.id} data-boundary-kind="host" x={region.x} y={region.y} width={region.width} height={region.height} rx="12" />
            <text class="map-region-label" x={region.x + 20} y={region.y + 28}>{region.label}</text>
          </g>)}
          <g class="map-layer-separation" aria-label="Frontend on the left; backend on the right">
            <text x="55" y="13">Frontend</text><text x="305" y="13">Backend</text>
            <line x1="275" y1="4" x2="275" y2={mapHeight - 10} />
          </g>
          {mapBoundaries.map((boundary) => <rect class={`map-boundary-outline map-${boundary.kind}`} data-map-group={boundary.id} data-boundary-kind={boundary.kind} x={boundary.x} y={boundary.y} width={boundary.width} height={boundary.height} rx="8" />)}
          <g id="map-edges"></g>
          {mapBoundaries.map((boundary) => <g id={`map-boundary-${boundary.id}`} class={`map-boundary-heading map-${boundary.kind}`} data-boundary-kind={boundary.kind} aria-label={`${boundary.label} · ${boundary.title}`}>
            <desc id={`map-boundary-${boundary.id}-description`}>{boundary.label} · {boundary.title}. {boundary.detail}</desc>
            <rect x={boundary.x + 2} y={boundary.y + 2} width={boundary.width - 4} height="53" rx="6" />
            <text class="map-boundary-kind" data-boundary-label x={boundary.x + 16} y={boundary.y + 22}>{boundary.label}</text>
            <text class="map-boundary-title" data-boundary-title x={boundary.x + 16} y={boundary.y + 44}>{boundary.title}</text>
            {boundary.note && <text class="map-boundary-note" x={boundary.x + 16} y={boundary.y + boundary.height - 16}>{boundary.note}</text>}
          </g>)}
        </svg>
        {mapNodes.map((node) => <button type="button" class="topology-node" data-node-id={node.id} aria-pressed="false" aria-describedby={`map-boundary-${mapBoundaries.find((boundary) => boundary.members.includes(node.id))?.id ?? "remote"}-description`} style={`left:${node.x / mapWidth * 100}%;top:${node.y / mapHeight * 100}%;width:${nodeWidth / mapWidth * 100}%;height:${nodeHeight / mapHeight * 100}%`}>
          <span class="map-node-top"><Icon name={node.icon} size={22} /><span class="map-node-role">{node.role}</span></span>
          <strong data-node-label>{node.label}</strong>
        </button>)}
      </div>
    </div>
  </div>
  <div class="map-footer">
    <ul id="map-help" class="map-help" aria-label="Map navigation tips">
      <li><strong>Pan</strong><span>Drag or use arrow keys</span></li>
      <li><strong>Zoom</strong><span>Scroll, pinch or <kbd>+</kbd> / <kbd>−</kbd></span></li>
      <li><strong>Fit</strong><span><kbd>0</kbd></span></li>
      <li><strong>Highlight</strong><span>Select a component · <kbd>Esc</kbd> to clear</span></li>
    </ul>
    <p id="map-selection" class="map-selection" role="status">No component selected</p>
  </div>
</article>
