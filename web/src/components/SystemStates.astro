<section id="system-states" class="state-overview" aria-label="System states">
  <article class="panel state-lanes-panel" aria-labelledby="state-lanes-title">
    <div class="panel-heading">
      <div>
        <h2 id="state-lanes-title">State lanes</h2>
        <p>Exact state changes in <span id="state-lanes-range">the selected period</span></p>
      </div>
    </div>
    <div id="state-lanes" class="state-lanes" role="img" aria-label="State lane timeline awaiting supervisor history">
      <div class="chart-placeholder">Waiting for supervisor history…</div>
    </div>
    <div id="state-notice" class="chart-notice" role="status" hidden></div>
  </article>

  <article class="panel state-ring-panel" aria-labelledby="state-ring-title">
    <div class="panel-heading">
      <div>
        <h2 id="state-ring-title">Composition</h2>
        <p>Observed time in <span id="state-ring-range">the selected period</span></p>
      </div>
    </div>
    <div class="state-ring-layout">
      <div id="state-ring" class="state-ring" role="img" aria-label="State composition awaiting supervisor history">
        <div class="chart-placeholder">Waiting…</div>
      </div>
      <div id="state-legend" class="state-legend"></div>
    </div>
    <div class="panel-bottom">
      <span>Tracked time</span>
      <span id="state-ring-total">—</span>
    </div>
  </article>
</section>
