---
import Icon from "./Icon.astro"
import StatsGrid from "./StatsGrid.astro"
import TrafficPanel from "./TrafficPanel.astro"
import ThemePicker from "./ThemePicker.astro"
---
<section id="overview" aria-labelledby="overview-title">
  <div class="appearance-controls"><ThemePicker /></div>
  <div class="page-heading"><div><div class="eyebrow">YOUR RELAY, AT A GLANCE</div><h1 id="overview-title">Overview<span class="title-dot">.</span></h1><p>Less upload. The exact same conversation.</p></div><div class="heading-actions"><button class="button" id="open-desktop" type="button" aria-describedby="desktop-status" disabled><Icon name="desktop" size={16} />Open OpenCode Desktop</button><button class="icon-button" id="pause-button" type="button" aria-label="Pause automatic refresh" title="Pause automatic refresh"><Icon name="pause" size={17} /></button><button class="button button-secondary" id="refresh-button" type="button"><Icon name="refresh" size={16} />Refresh</button></div></div>
  <p id="desktop-status" class="control-detail" role="status">Checking the local Desktop launcher…</p>
  <div class="connection-line"><span class="live-badge" id="connection-badge"><span class="tiny-dot"></span><span id="connection-label">Connecting</span></span><span id="updated-at">Waiting for local gateway</span><span class="refresh-note" id="refresh-note">Auto-refresh every 10s</span></div>
  <div id="notice" class="notice" role="status" hidden></div>
  <noscript><div class="notice">Enable JavaScript to load local diagnostics. This page makes no provider requests.</div></noscript>

  <StatsGrid />
  <TrafficPanel />
</section>
