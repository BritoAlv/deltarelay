---
import Icon from "./Icon.astro"
---
<div class="stats-grid" id="stats-grid">
  <article class="stat-card primary-stat"><div class="stat-label">Upload reduction<Icon name="arrow" size={18} /></div><div class="stat-value accent" id="stat-reduction">—</div><div class="stat-foot"><span>vs. original bodies</span></div></article>
  <article class="stat-card"><div class="stat-label">Bandwidth saved<Icon name="download" size={17} /></div><div class="stat-value" id="stat-saved">—</div><div class="stat-foot" id="stat-saved-foot">No data</div></article>
  <article class="stat-card"><div class="stat-label">Tracked sessions<Icon name="sessions" size={18} /></div><div class="stat-value" id="stat-sessions">—</div><div class="stat-foot"><span class="tiny-dot" id="active-session-dot" aria-hidden="true"></span><span id="stat-sessions-foot">No data</span></div></article>
  <article class="stat-card"><div class="stat-label">Model requests<Icon name="activity" size={18} /></div><div class="stat-value" id="stat-requests">—</div><div class="stat-foot" id="stat-requests-foot">No data</div></article>
</div>
