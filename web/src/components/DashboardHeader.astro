---
import Icon from "./Icon.astro"
import ThemePicker from "./ThemePicker.astro"

interface Props {
  title: string
  group: string
  refreshNote?: string
  idPrefix?: string
  showHostFilter?: boolean
}

const { title, group, refreshNote = "Auto-refresh every 10s", idPrefix = "", showHostFilter = false } = Astro.props
const id = (name: string) => `${idPrefix}${name}`
---
<header class="topbar">
  <div class="topbar-crumb">
    <span class="topbar-brand" aria-hidden="true"><Icon name="deltarelay" size={17} /></span>
    <span class="topbar-product">{group}</span>
    <span class="topbar-slash" aria-hidden="true">/</span>
    <strong title={title}>{title}</strong>
  </div>
  <div class="topbar-actions">
    <div class="topbar-status">
      <span class="live-badge" id={id("connection-badge")} role="status" aria-live="polite"><span class="tiny-dot" aria-hidden="true"></span><span id={id("connection-label")}>Connecting…</span></span>
      <span id={id("updated-at")} class="topbar-updated">Loading local data…</span>
      <span class="refresh-note" id={id("refresh-note")}>{refreshNote}</span>
    </div>
    {showHostFilter && (
      <label class="host-filter" title="Filter history by remote host">
        <span class="sr-only">Remote host</span>
        <select id={id("host-filter")} name="host" autocomplete="off"><option value="">All hosts</option></select>
      </label>
    )}
    <details class="theme-popover">
      <summary aria-label="Appearance" title="Appearance"><Icon name="palette" size={15} /></summary>
      <div class="theme-popover-body"><ThemePicker id={id("theme-popover")} primary={false} /></div>
    </details>
    <div class="topbar-buttons">
      <button class="icon-button" id={id("pause-button")} type="button" aria-label="Pause automatic refresh" aria-pressed="false" title="Pause automatic refresh"><Icon name="pause" size={17} /></button>
      <button class="button button-secondary topbar-refresh" id={id("refresh-button")} type="button"><Icon name="refresh" size={16} /><span class="button-label">Refresh</span></button>
    </div>
  </div>
</header>
