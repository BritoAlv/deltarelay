---
import { iconDefinition, type IconName } from "../lib/icons"
interface Props { name: IconName; size?: number; class?: string }
const { name, size = 20, class: className } = Astro.props
const { viewBox, body, brand } = iconDefinition(name)
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox={viewBox} fill={brand ? "currentColor" : "none"} stroke={brand ? "none" : "currentColor"} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true" focusable="false" set:html={body} />
