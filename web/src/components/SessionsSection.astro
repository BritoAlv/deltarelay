---
import Icon from "./Icon.astro"
import UsagePanel from "./UsagePanel.astro"

const pageSizes = [8, 25, 50, 100]
const columns = [
  { key: "session", label: "Session", sortLabel: "session", filterLabel: "session", number: false, filterable: true },
  { key: "host", label: "Remote codespace host", sortLabel: "remote codespace host", filterLabel: "remote host", number: false, filterable: true },
  { key: "state", label: "State", sortLabel: "state", filterLabel: "state", number: false, filterable: true },
  { key: "key", label: "Credential label", sortLabel: "credential label", filterLabel: "credential label", number: false, filterable: true },
  { key: "requests", label: "Requests", sortLabel: "requests", filterLabel: "requests", number: true, filterable: true },
  { key: "original", label: "Original", sortLabel: "original size", filterLabel: "original size", number: true, filterable: true },
  { key: "uploaded", label: "Uploaded", sortLabel: "uploaded size", filterLabel: "uploaded size", number: true, filterable: true },
  { key: "reduction", label: "Reduction", sortLabel: "reduction", filterLabel: "reduction", number: true, filterable: true },
  { key: "input", label: "Input tokens", sortLabel: "input tokens", filterLabel: "input tokens", number: true, filterable: true },
  { key: "output", label: "Output tokens", sortLabel: "output tokens", filterLabel: "output tokens", number: true, filterable: true },
  { key: "context", label: "Context", sortLabel: "context", filterLabel: "context", number: true, filterable: true },
  { key: "activity", label: "Last activity", sortLabel: "last activity", filterLabel: "last activity", number: false, filterable: true },
] as const
---
<section id="sessions" class="sessions-section" aria-labelledby="sessions-title">
  <h2 id="sessions-title" class="sr-only">Retained sessions</h2>
  <UsagePanel />
  <article class="panel data-panel sessions-panel">
    <div class="table-toolbar">
      <div class="search-field">
        <Icon name="search" size={17} />
        <label class="sr-only" for="session-search">Search session ID or upstream</label>
        <input id="session-search" name="session-search" type="search" placeholder="Search sessions or upstreams…" autocomplete="off" spellcheck="false" />
      </div>
      <button class="text-button clear-filters-button" id="clear-session-filters" type="button" hidden><Icon name="close" size={13} />Clear filters</button>
      <span class="count-badge" id="session-count" aria-hidden="true">—</span>
      <div class="compact-sort" id="session-sort-controls">
        <label class="compact-sort-field"><span>Sort</span><select id="session-sort" aria-label="Sort sessions by">
          <option value="session">Session</option>
          <option value="host">Remote host</option>
          <option value="state">State</option>
          <option value="key">Credential label</option>
          <option value="requests">Requests</option>
          <option value="original">Original</option>
          <option value="uploaded">Uploaded</option>
          <option value="reduction">Reduction</option>
          <option value="input">Input tokens</option>
          <option value="output">Output tokens</option>
          <option value="context">Context</option>
          <option value="activity">Activity</option>
        </select></label>
        <button class="compact-sort-direction" id="session-sort-direction" type="button" aria-label="Sort direction: descending" title="Reverse sort direction"><Icon name="chevron" size={12} /></button>
      </div>
      <button class="text-button export-button" id="export-button" type="button" disabled><Icon name="download" size={16} />Export CSV</button>
    </div>
    <div class="table-scroll" id="session-table-scroll">
      <table>
        <caption class="sr-only">Retained sessions with the remote codespace host, state, saved credential label, request counts, transfer sizes, upload reduction, locally observed input and output tokens, context size, and last activity. Sortable column headers are available on wide screens; each sortable header also has a column filter. A sort control is available on narrow screens.</caption>
        <thead>
          <tr>
            {columns.map((column) => (
              <th scope="col" class={column.number ? "number" : undefined} data-sort-key={column.key} aria-sort={column.key === "activity" ? "descending" : "none"}>
                <div class="th-tools">
                  <button class="table-sort" type="button" data-sort-key={column.key} data-sort-label={column.sortLabel} aria-label={`Sort by ${column.sortLabel}`}>
                    <span>{column.label}</span>
                    <span class="sort-indicator" aria-hidden="true"><Icon name="chevron" size={8} class="sort-up" /><Icon name="chevron" size={8} class="sort-down" /></span>
                  </button>
                  {column.filterable && (
                    <button class="column-filter" type="button" data-filter-key={column.key} aria-label={`Filter by ${column.filterLabel}`} aria-haspopup="dialog" aria-expanded="false" aria-controls="session-filter-popover" title={`Filter by ${column.filterLabel}`}><Icon name="filter" size={11} /></button>
                  )}
                </div>
              </th>
            ))}
            <th scope="col"><span class="sr-only">Details</span></th>
          </tr>
        </thead>
        <tbody id="session-rows"></tbody>
      </table>
    </div>
    <div class="empty-state" id="sessions-empty">
      <span class="empty-icon"><Icon name="sessions" size={28} /></span>
      <h3>Loading sessions…</h3>
      <p>Waiting for the local gateway to return retained sessions.</p>
      <button class="text-button empty-clear-button" id="clear-session-filters-empty" type="button" hidden><Icon name="close" size={13} />Clear filters</button>
    </div>
    <div class="table-footer">
      <span id="table-summary" role="status" aria-live="polite">Loading sessions…</span>
      <div class="pagination">
        <label class="page-size-field"><span>Rows</span><select id="session-page-size" aria-label="Rows per page">
          {pageSizes.map((size) => <option value={size}>{size}</option>)}
        </select></label>
        <button class="text-button" id="previous-page" type="button" aria-label="Previous page" disabled>Previous</button>
        <span id="page-label">Page 1 of 1</span>
        <button class="text-button" id="next-page" type="button" aria-label="Next page" disabled>Next</button>
      </div>
    </div>
  </article>
  <div class="filter-popover" id="session-filter-popover" role="dialog" aria-modal="false" aria-labelledby="session-filter-popover-title" hidden>
    <span class="filter-popover-caret" id="session-filter-caret" aria-hidden="true"></span>
    <div class="filter-popover-head">
      <h3 id="session-filter-popover-title">Filter</h3>
      <button class="filter-popover-close" id="close-session-filter" type="button" aria-label="Close filter"><Icon name="close" size={15} /></button>
    </div>
    <div class="filter-popover-body" id="session-filter-popover-body"></div>
    <p class="filter-hint" id="session-filter-hint" role="status" hidden></p>
    <div class="filter-popover-foot">
      <button class="text-button" id="clear-session-filter" type="button">Clear</button>
      <button class="text-button filter-done" id="done-session-filter" type="button">Done</button>
    </div>
  </div>
</section>
