---
import Icon from "./Icon.astro"
---
<section id="sessions" class="sessions-section" aria-labelledby="sessions-title">
  <h2 id="sessions-title" class="sr-only">Retained sessions</h2>
  <article class="panel sessions-panel">
    <div class="table-toolbar">
      <div class="search-field">
        <Icon name="search" size={17} />
        <label class="sr-only" for="session-search">Search session ID or upstream</label>
        <input id="session-search" name="session-search" type="search" placeholder="Search sessions or upstreams…" autocomplete="off" spellcheck="false" />
      </div>
      <div class="filter-chips" id="session-filter-chips" role="group" aria-label="Filter sessions by state">
        <button type="button" class="filter-chip" data-filter-value="all" aria-pressed="true">All</button>
        <button type="button" class="filter-chip" data-filter-value="active" aria-pressed="false">Active</button>
        <button type="button" class="filter-chip" data-filter-value="idle" aria-pressed="false">Idle</button>
        <button type="button" class="filter-chip" data-filter-value="attention" aria-pressed="false">Needs attention</button>
      </div>
      <span class="count-badge" id="session-count" aria-hidden="true">0</span>
      <div class="compact-sort" id="session-sort-controls">
        <label class="compact-sort-field"><span>Sort</span><select id="session-sort" aria-label="Sort sessions by">
          <option value="session">Session</option>
          <option value="host">Remote host</option>
          <option value="state">State</option>
          <option value="requests">Requests</option>
          <option value="original">Original</option>
          <option value="uploaded">Uploaded</option>
          <option value="reduction">Reduction</option>
          <option value="activity">Activity</option>
        </select></label>
        <button class="compact-sort-direction" id="session-sort-direction" type="button" aria-label="Sort direction: descending" title="Reverse sort direction"><Icon name="chevron" size={12} /></button>
      </div>
      <button class="text-button export-button" id="export-button" type="button" disabled><Icon name="download" size={16} />Export CSV</button>
    </div>
    <div class="table-scroll" id="session-table-scroll">
      <table>
        <caption class="sr-only">Retained sessions with the remote codespace host, request counts, transfer sizes, upload reduction, and last activity. Sortable column headers are available on wide screens; a sort control is available on narrow screens.</caption>
        <thead>
          <tr>
            <th scope="col" data-sort-key="session" aria-sort="none"><button class="table-sort" type="button" data-sort-key="session" data-sort-label="session"><span>Session</span><span class="sort-indicator" aria-hidden="true"><Icon name="chevron" size={8} class="sort-up" /><Icon name="chevron" size={8} class="sort-down" /></span></button></th>
            <th scope="col" data-sort-key="host" aria-sort="none"><button class="table-sort" type="button" data-sort-key="host" data-sort-label="remote codespace host"><span>Remote codespace host</span><span class="sort-indicator" aria-hidden="true"><Icon name="chevron" size={8} class="sort-up" /><Icon name="chevron" size={8} class="sort-down" /></span></button></th>
            <th scope="col" data-sort-key="state" aria-sort="none"><button class="table-sort" type="button" data-sort-key="state" data-sort-label="state"><span>State</span><span class="sort-indicator" aria-hidden="true"><Icon name="chevron" size={8} class="sort-up" /><Icon name="chevron" size={8} class="sort-down" /></span></button></th>
            <th scope="col" class="number" data-sort-key="requests" aria-sort="none"><button class="table-sort" type="button" data-sort-key="requests" data-sort-label="requests"><span>Requests</span><span class="sort-indicator" aria-hidden="true"><Icon name="chevron" size={8} class="sort-up" /><Icon name="chevron" size={8} class="sort-down" /></span></button></th>
            <th scope="col" class="number" data-sort-key="original" aria-sort="none"><button class="table-sort" type="button" data-sort-key="original" data-sort-label="original size"><span>Original</span><span class="sort-indicator" aria-hidden="true"><Icon name="chevron" size={8} class="sort-up" /><Icon name="chevron" size={8} class="sort-down" /></span></button></th>
            <th scope="col" class="number" data-sort-key="uploaded" aria-sort="none"><button class="table-sort" type="button" data-sort-key="uploaded" data-sort-label="uploaded size"><span>Uploaded</span><span class="sort-indicator" aria-hidden="true"><Icon name="chevron" size={8} class="sort-up" /><Icon name="chevron" size={8} class="sort-down" /></span></button></th>
            <th scope="col" class="number" data-sort-key="reduction" aria-sort="none"><button class="table-sort" type="button" data-sort-key="reduction" data-sort-label="reduction"><span>Reduction</span><span class="sort-indicator" aria-hidden="true"><Icon name="chevron" size={8} class="sort-up" /><Icon name="chevron" size={8} class="sort-down" /></span></button></th>
            <th scope="col" data-sort-key="activity" aria-sort="descending"><button class="table-sort" type="button" data-sort-key="activity" data-sort-label="last activity"><span>Last activity</span><span class="sort-indicator" aria-hidden="true"><Icon name="chevron" size={8} class="sort-up" /><Icon name="chevron" size={8} class="sort-down" /></span></button></th>
            <th scope="col"><span class="sr-only">Details</span></th>
          </tr>
        </thead>
        <tbody id="session-rows"></tbody>
      </table>
    </div>
    <div class="empty-state" id="sessions-empty">
      <span class="empty-icon"><Icon name="sessions" size={28} /></span>
      <h3>No sessions recorded</h3>
      <p>Requests routed through the gateway will appear here.</p>
    </div>
    <div class="table-footer">
      <span id="table-summary" role="status" aria-live="polite">0 sessions</span>
      <div class="pagination">
        <button class="text-button" id="previous-page" type="button" aria-label="Previous page" disabled>Previous</button>
        <span id="page-label">Page 1 of 1</span>
        <button class="text-button" id="next-page" type="button" aria-label="Next page" disabled>Next</button>
      </div>
    </div>
  </article>
</section>
