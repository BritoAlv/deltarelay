{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["test/**/*.ts", "src/lib/**/*.ts"]
}
